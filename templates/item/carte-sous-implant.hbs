<div class="cp-barrette {{#if edition}}cp-barrette-mj{{/if}}">
  {{> "systems/cyberpunk2075/templates/item/partials/haut.hbs"}}

  <div class="cp-c-zone">
    {{#if edition}}
    <div class="cp-c-etiquette cp-c-formulaire">
      <img class="cp-c-image cp-c-image-edition" src="{{item.img}}" alt="" data-action="editImage" data-edit="img" title="Changer l'image">
      <div class="cp-c-grille3">
        <label class="cp-c-f cp-span3">Nom<input class="cp-c-inp cp-c-inp-nom" type="text" name="name" value="{{item.name}}"></label>
        <label class="cp-c-f">Prix (€$)<input class="cp-c-inp" type="number" name="system.prix" value="{{system.prix}}" min="0"></label>
        <label class="cp-c-f">Coût d'installation 💀<input class="cp-c-inp" type="number" name="system.coutInstallation" value="{{system.coutInstallation}}" min="0"></label>
        {{#if capsule}}
        <label class="cp-c-f">Type de dégâts<select class="cp-c-sel" name="system.typeDegats">{{selectOptions choixDegats selected=system.typeDegats}}</select></label>
        <label class="cp-c-f">Dé ajouté<input class="cp-c-inp" type="text" name="system.de" value="{{system.de}}"></label>
        {{/if}}
        <label class="cp-c-f cp-span3">Phrase d'ambiance<input class="cp-c-inp cp-c-inp-texte" type="text" name="system.ambiance" value="{{system.ambiance}}"></label>
      </div>
    </div>
    {{else}}
    <div class="cp-c-etiquette">
      <img class="cp-c-image" src="{{item.img}}" alt="">
      <div class="cp-c-texte">
        <span class="cp-lbl cp-c-surtitre">{{typeLabel}}</span>
        <span class="cp-c-nom">{{item.name}}</span>
        {{#if system.ambiance}}<span class="cp-c-ambiance">{{system.ambiance}}</span>{{/if}}
        <div class="cp-c-tags">
          <span class="cp-lbl cp-c-tag">{{prix}}</span>
          <span class="cp-lbl cp-c-tag">+{{system.coutInstallation}}💀</span>
          {{#if hote}}<span class="cp-lbl cp-c-tag">Sur : {{hote}}</span>{{/if}}
        </div>
      </div>
      <div class="cp-c-code"><div class="cp-c-barres" aria-hidden="true"></div><span class="cp-num">{{codeBarre}}</span></div>
    </div>
    {{/if}}
  </div>

  {{#if edition}}
  {{#unless capsule}}
  <div class="cp-c-section">
    <label class="cp-c-f">Effet<input class="cp-c-inp cp-c-inp-texte" type="text" name="system.effet.description" value="{{system.effet.description}}" placeholder="ex. Zoom"></label>
    <div class="cp-c-f">Modificateurs (appliqués tant que l'amélioration est posée)
      <div class="cp-c-modifs" data-modifs="{{cheminModifs}}">
        {{#each modifs}}
        <div class="cp-c-modif" data-ligne>
          <select class="cp-c-sel" data-modif="cible" aria-label="Cible">{{selectOptions ../choixCibles selected=cible}}</select>
          <input class="cp-c-inp cp-c-court" type="text" data-modif="valeur" value="{{valeur}}" aria-label="Valeur">
          <button type="button" class="cp-x" data-action="supprimerModif" data-chemin="{{../cheminModifs}}" data-index="{{i}}" aria-label="Retirer">×</button>
        </div>
        {{/each}}
        <button type="button" class="cp-c-depot" data-action="ajouterModif" data-chemin="{{cheminModifs}}">+ Ajouter un modificateur</button>
      </div>
    </div>
  </div>
  {{/unless}}
  <div class="cp-c-section"><label class="cp-c-f">Règles<textarea class="cp-c-inp cp-c-inp-texte" name="system.description" rows="3">{{system.description}}</textarea></label></div>
  {{else}}
  <div class="cp-c-puces cp-c-puces-3">
    {{#each puces}}
    <div class="cp-c-pins"><div class="cp-c-puce"><span class="cp-lbl cp-doux">{{label}}</span><span class="cp-c-val {{#if num}}cp-num cp-c-val-grand{{/if}} {{#if couleur}}cp-t-{{couleur}}{{/if}}">{{valeur}}</span></div></div>
    {{/each}}
  </div>
  <div class="cp-c-cables cp-c-puces-3"><div class="cp-c-vt"></div><div class="cp-c-vt"></div><div class="cp-c-vt"></div></div>
  <div class="cp-c-bus"><span class="cp-pastille-cable"></span><span class="cp-c-trace"></span><span class="cp-pastille-cable"></span></div>
  <div class="cp-c-regles"><div class="cp-col cp-gap6 cp-pousse"><span class="cp-lbl cp-doux">Règles</span>{{#if regles}}<div class="cp-c-p">{{{regles}}}</div>{{else}}<p class="cp-c-p cp-doux">{{#if capsule}}Ajoute son dé aux dégâts de l'arme intégrée du bras.{{else}}—{{/if}}</p>{{/if}}</div></div>
  {{/if}}

  {{> "systems/cyberpunk2075/templates/item/partials/bas.hbs" bloc=(ifThen capsule "Capsule · 1 max par bras" "Amélioration · slot d'implant") note="Compte dans le minimum d'humanité"}}
</div>

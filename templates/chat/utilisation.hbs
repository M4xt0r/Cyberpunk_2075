<div class="cp-msg">
  <div class="cp-msg-qui"><span>{{acteur}}</span><span>{{heure}}</span></div>
  <div class="cp-msg-etiquette">
    <span class="cp-msg-type">{{type}}</span>
    <span class="cp-msg-titre">{{titre}}</span>
  </div>

  {{#if jet}}
  <div class="cp-msg-puce">
    <span class="cp-msg-total {{#if jet.soin}}cp-vert{{else}}cp-jaune{{/if}}">{{jet.total}}</span>
    <div class="cp-msg-des">
      <span class="cp-num cp-msg-detail">{{jet.formule}} : {{jet.detail}}</span>
      <span>{{jet.typeLabel}}</span>
    </div>
  </div>
  {{/if}}

  {{#if humanite}}
  <div class="cp-msg-puce cp-msg-colonne">
    <div class="cp-msg-ligne">
      <span class="cp-num cp-msg-source">Humanité</span>
      <span class="cp-num"><b>{{humanite.avant}} → {{humanite.apres}}</b> / {{humanite.max}}</span>
      <span class="cp-num cp-msg-cout {{#if humanite.baisse}}cp-vert{{/if}}">{{humanite.cout}}</span>
    </div>
    <div class="cp-msg-jauge"><div style="width:{{humanite.pct}}%"></div></div>
  </div>
  {{/if}}

  {{#if description}}<div class="cp-msg-note">{{description}}</div>{{/if}}
  {{#if kill}}<div class="cp-msg-note cp-rouge-txt">{{kill}}</div>{{/if}}
  {{#if restant}}<div class="cp-msg-note">{{restant}}</div>{{/if}}

  {{#if jet}}
  <div class="cp-msg-boutons cp-msg-colonne">
    {{#each cibles}}
    <button type="button" class="cp-msg-bt" data-cp-action="appliquer" data-nature="{{#if ../jet.soin}}soin{{else}}degats{{/if}}" data-montant="{{../jet.total}}" data-cible="{{token}}">{{#if ../jet.soin}}Soigner{{else}}Appliquer à{{/if}} {{nom}}</button>
    {{/each}}
    {{#if jet.soin}}
    <button type="button" class="cp-msg-bt{{#if cibles.length}}2{{/if}}" data-cp-action="appliquer" data-nature="soin" data-montant="{{jet.total}}" data-cible="soi">Soigner {{nomSoi}}</button>
    {{/if}}
  </div>
  {{/if}}
  <div class="cp-msg-broches"></div>
</div>

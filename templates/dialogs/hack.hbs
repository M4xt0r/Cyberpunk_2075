<div class="cp-dlg">
  <div class="cp-etiquette"><span class="cp-etiquette-titre">{{titre}}</span><span class="cp-num">{{formule}}</span></div>
  {{#if effet}}<p class="cp-petit cp-doux cp-sans-marge">{{effet}}</p>{{/if}}

  {{#if variable}}
  <label class="cp-champ">
    <span class="cp-legende">Nombre ({{unite}}){{#if base}} · base {{base}} RAM{{/if}} · {{parUnite}} RAM chacun</span>
    <input class="cp-inp cp-num" type="number" name="quantite" value="1" min="0" step="1">
  </label>
  {{/if}}

  <div class="cp-cout-hack">
    <span class="cp-lbl cp-doux">Coût</span>
    <span class="cp-num cp-cout-valeur" data-cout>{{cout}} RAM</span>
    <span class="cp-num cp-petit cp-doux" data-reste>reste {{ram}} / {{ramMax}}</span>
  </div>

  {{#if avecJet}}
  <fieldset class="cp-champ">
    <legend>Mode</legend>
    <div class="cp-seg">
      <label><input type="radio" name="mode" value="avantage"><span>Avantage</span></label>
      <label><input type="radio" name="mode" value="normal" {{#unless desavantage}}checked{{/unless}}><span>Normal</span></label>
      <label><input type="radio" name="mode" value="desavantage" {{#if desavantage}}checked{{/if}}><span>Désavantage</span></label>
    </div>
  </fieldset>
  {{#if desavantage}}<div class="cp-avert">Stress 1 : désavantage au piratage.</div>{{/if}}
  <label class="cp-champ">
    <span class="cp-legende">Bonus ou malus du MJ</span>
    <input class="cp-inp cp-num" type="text" name="bonus" value="+0">
  </label>
  {{/if}}

  {{#if overclocking}}
  <label class="cp-ligne cp-petit"><input type="checkbox" name="pv"> Payer en PV (OverClocking · {{vie}} PV)</label>
  {{/if}}

  <div class="cp-ligne cp-entre cp-petit cp-doux">
    <span>{{#if nbCibles}}{{nbCibles}} cible{{#if (gt nbCibles 1)}}s{{/if}} visée{{#if (gt nbCibles 1)}}s{{/if}}{{else}}Aucune cible visée (touche T){{/if}}</span>
    {{#if avecJet}}<span>contre Glace</span>{{/if}}
  </div>
</div>

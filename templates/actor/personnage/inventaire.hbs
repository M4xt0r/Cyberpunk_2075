<section class="tab cp-page cp-page-inventaire {{tab.cssClass}}" data-group="primary" data-tab="inventaire">
  <div class="cp-combat-grille cp-grille-inventaire">

    <div class="cp-col cp-gap16">
      <div class="cp-carte cp-coupe cp-eddies">
        <span class="cp-lbl cp-doux">Eddies</span>
        <span class="cp-ligne-base">
          <input class="cp-inp-grand cp-num" type="number" name="system.eddies" value="{{system.eddies}}" step="1" aria-label="Eddies" {{#unless peutModifier}}disabled{{/unless}}>
          <span class="cp-num cp-jaune">€$</span>
        </span>
      </div>

      <section class="cp-col cp-gap8">
        <div class="cp-ligne cp-entre"><h2 class="cp-lbl cp-doux cp-titre-h2">Inventaire</h2><span class="cp-petit cp-doux">{{#if edition}}Quantité · Porté{{else}}ⓘ ouvre la carte de l'objet{{/if}}</span></div>
        <div class="cp-carte cp-coupe cp-inventaire">
          {{#each objets}}
          <div class="cp-objet {{#if bloque}}cp-objet-vide{{/if}}" data-item-id="{{id}}">
            {{#if ../edition}}
            <button type="button" class="cp-x" data-action="supprimerItem" aria-label="Retirer {{nom}}">×</button>
            <span class="cp-pousse cp-objet-nom">{{nom}}</span>
            {{#if aNiveaux}}<select class="cp-inp cp-sel-niveau" data-item-champ="system.niveau" aria-label="Niveau possédé">{{selectOptions ../choixNiveaux selected=niveauPossede}}</select>{{/if}}
            <input class="cp-inp cp-num cp-court cp-qte-inp" type="number" min="0" value="{{quantite}}" data-item-champ="system.quantite" aria-label="Quantité {{nom}}">
            {{#if sePorte}}<input type="checkbox" data-action="basculerPorte" {{checked porte}} aria-label="{{nom}} porté">{{else}}<span class="cp-case-vide"></span>{{/if}}
            {{else}}
            <button type="button" class="cp-ib" data-action="ouvrirItem" aria-label="Infos {{nom}}">i</button>
            <div class="cp-col cp-pousse">
              <span class="cp-objet-nom">{{nom}}
                {{#if niveau}}<span class="cp-badge-niv cp-c-{{niveau.couleur}}">{{niveau.label}}</span>{{/if}}
                {{#if sePorte}}<button type="button" class="cp-badge-porte {{#if porte}}cp-plein{{/if}}" data-action="basculerPorte" title="Porter / ranger" {{#unless ../peutModifier}}disabled{{/unless}}>{{#if porte}}Porté{{else}}Rangé{{/if}}</button>{{/if}}
                {{#if enCours}}<button type="button" class="cp-badge-actif" data-action="arreterEffet" title="Arrêter l'effet" {{#unless ../peutModifier}}disabled{{/unless}}>Actif · {{tours}} t.</button>{{/if}}
              </span>
              <span class="cp-petit cp-doux">{{{resume}}}{{#if usages}} · {{usages}}{{/if}}</span>
            </div>
            <span class="cp-qte">
              <button type="button" class="cp-qb" data-action="ajusterItem" data-champ="system.quantite" data-delta="-1" aria-label="Retirer un {{nom}}" {{#unless ../peutModifier}}disabled{{/unless}}>−</button>
              <span class="cp-num">{{quantite}}</span>
              <button type="button" class="cp-qb" data-action="ajusterItem" data-champ="system.quantite" data-delta="1" aria-label="Ajouter un {{nom}}" {{#unless ../peutModifier}}disabled{{/unless}}>+</button>
            </span>
            {{#if utilisable}}
            <button type="button" class="cp-btn cp-btn-principal cp-btn-petit cp-btn-utiliser" data-action="utiliser" {{#if bloque}}disabled title="{{blocage}}"{{/if}}>{{labelUtiliser}}</button>
            {{else}}<span class="cp-btn-utiliser"></span>{{/if}}
            {{/if}}
          </div>
          {{else}}
          <p class="cp-petit cp-doux">Inventaire vide.</p>
          {{/each}}
          {{#if edition}}<div class="cp-zone-depot">+ Glisser un objet depuis le compendium</div>{{/if}}
        </div>
      </section>
    </div>

    <div class="cp-col cp-gap16">
      {{!-- ====== Véhicules ====== --}}
      <section class="cp-col cp-gap8">
        <div class="cp-ligne cp-entre"><h2 class="cp-lbl cp-doux cp-titre-h2">Véhicules</h2><span class="cp-petit cp-doux">ⓘ ouvre la fiche du véhicule</span></div>
        {{#each vehicules}}
        <div class="cp-carte cp-coupe cp-bien-carte {{#if detruit}}cp-bien-detruit{{/if}}" data-bien="{{uuid}}" data-bien-depot>
          {{#if manquant}}
          <div class="cp-ligne cp-entre"><span class="cp-petit cp-rouge-txt">{{nom}} (supprimé ?)</span>{{#if ../peutModifier}}<button type="button" class="cp-x" data-action="retirerVehicule" aria-label="Retirer">×</button>{{/if}}</div>
          {{else}}
          <div class="cp-ligne cp-gap8">
            <img class="cp-bien-vignette" src="{{img}}" alt="">
            <div class="cp-col cp-pousse">
              <span class="cp-ligne cp-gap6"><button type="button" class="cp-ib cp-ib-rond" data-action="ouvrirActeur" aria-label="Fiche de {{nom}}">i</button><span class="cp-bien-nom">{{nom}}</span></span>
              <span class="cp-petit cp-doux">{{categorie}}{{#if blinde}} · blindé{{/if}}{{#if pilote}} · pilote : {{pilote}}{{/if}}{{#if endommage}} · <span class="cp-rouge-txt">endommagé</span>{{/if}}{{#if detruit}} · <span class="cp-rouge-txt">détruit</span>{{/if}}</span>
            </div>
            <button type="button" class="cp-btn cp-btn-principal cp-btn-mini" data-action="piloterVehicule" title="Poursuite : 1d20 + Pilotage + Maniabilité + Vitesse">Piloter</button>
            {{#if ../edition}}<button type="button" class="cp-x" data-action="retirerVehicule" aria-label="Retirer {{nom}} de la fiche" title="Retirer de la fiche (le véhicule n'est pas supprimé)">×</button>{{/if}}
          </div>
          <div class="cp-bien-champs">
            <label class="cp-bien-champ"><span class="cp-lbl cp-doux">Vitesse</span>
              {{#if modifiable}}<select class="cp-inp" data-bien-champ="system.vitesse">{{selectOptions ../choixVitessesBien selected=vitesse}}</select>{{else}}<span class="cp-num">{{vitesse}}</span>{{/if}}
              {{#if vitesseModifiee}}<span class="cp-petit cp-jaune">→ {{vitesseEffective}}</span>{{/if}}</label>
            <label class="cp-bien-champ"><span class="cp-lbl cp-doux">Maniab.</span>
              {{#if modifiable}}<input class="cp-inp cp-num" type="number" data-bien-champ="system.maniabilite" data-type="nombre" value="{{maniabilite}}">{{else}}<span class="cp-num">{{maniabilite}}</span>{{/if}}
              {{#if (ne maniabilite maniabiliteEffective)}}<span class="cp-petit cp-jaune">→ {{maniabiliteEffective}}</span>{{/if}}</label>
            <label class="cp-bien-champ"><span class="cp-lbl cp-doux">PV</span>
              <span class="cp-ligne cp-gap4">{{#if modifiable}}<input class="cp-inp cp-num" type="number" data-bien-champ="system.vie.value" data-type="nombre" value="{{vie}}" min="0">{{else}}<span class="cp-num">{{vie}}</span>{{/if}}<span class="cp-num cp-doux">/{{vieMax}}</span></span></label>
            <label class="cp-bien-champ"><span class="cp-lbl cp-doux">Places</span>
              {{#if modifiable}}<input class="cp-inp cp-num" type="number" data-bien-champ="system.places" data-type="nombre" value="{{places}}" min="0">{{else}}<span class="cp-num">{{places}}</span>{{/if}}</label>
          </div>
          <div class="cp-barre"><div class="cp-barre-rempli cp-fond-rouge" style="width:{{viePct}}%"></div></div>
          <div class="cp-col cp-gap4">
            <span class="cp-ligne cp-entre"><span class="cp-lbl cp-doux">Améliorations</span><span class="cp-num cp-petit {{#if slotsPleins}}cp-rouge-txt{{/if}}">{{slotsUtilises}}/{{slots}} slots</span></span>
            {{#each ameliorations}}
            <div class="cp-ligne cp-gap6 cp-bien-ligne" data-item-id="{{id}}">
              <button type="button" class="cp-ib cp-ib-rond" data-action="ouvrirItemBien" aria-label="Infos {{nom}}">i</button>
              <span class="cp-pousse cp-petit">{{nom}}{{#if niveau}} <span class="cp-badge-niv cp-c-{{niveau.couleur}}">{{niveau.label}}</span>{{/if}}{{#if probleme}} <span class="cp-rouge-txt" title="{{probleme}}">!</span>{{/if}}</span>
              {{#if ../modifiable}}{{#if ../../edition}}<button type="button" class="cp-x" data-action="supprimerItemBien" aria-label="Retirer {{nom}}">×</button>{{/if}}{{/if}}
            </div>
            {{else}}<span class="cp-petit cp-doux">Aucune{{#if modifiable}} · glisse une amélioration sur cette carte{{/if}}</span>{{/each}}
          </div>
          {{/if}}
        </div>
        {{else}}
        <p class="cp-petit cp-doux">Aucun véhicule.</p>
        {{/each}}
        {{#if peutModifier}}
        <div class="cp-ligne cp-gap6">
          {{#if peutCreerActeur}}<button type="button" class="cp-c-depot cp-pousse" data-action="ajouterVehicule">+ Ajouter un véhicule</button>{{/if}}
          <select class="cp-inp cp-pousse" data-lier-vehicule aria-label="Lier un véhicule existant"><option value="">Lier un véhicule existant…</option>{{selectOptions choixVehicules}}</select>
        </div>
        <span class="cp-petit cp-doux">Ou glisse un véhicule depuis l'onglet Acteurs.</span>
        {{/if}}
      </section>

      {{!-- ====== Planque ====== --}}
      <section class="cp-col cp-gap8">
        <div class="cp-ligne cp-entre"><h2 class="cp-lbl cp-doux cp-titre-h2">Planque</h2><span class="cp-petit cp-doux">donnée par le MJ</span></div>
        {{#each planques}}
        <div class="cp-carte cp-coupe cp-bien-carte" data-bien="{{uuid}}" data-bien-depot>
          <div class="cp-ligne cp-gap8">
            <img class="cp-bien-vignette" src="{{img}}" alt="">
            <div class="cp-col cp-pousse">
              <span class="cp-ligne cp-gap6"><button type="button" class="cp-ib cp-ib-rond" data-action="ouvrirActeur" aria-label="Fiche de {{nom}}">i</button><span class="cp-bien-nom">{{nom}}</span>{{#if partagee}}<span class="cp-badge-type">Partagée</span>{{/if}}</span>
              <span class="cp-petit cp-doux">{{typeLabel}} · {{qualiteLabel}} · {{parking}} place{{#if (gt parking 1)}}s{{/if}} de parking{{#if hebergement}} · loge {{hebergement}}{{/if}}</span>
            </div>
            <label class="cp-ligne cp-petit cp-bien-present" title="Les bonus des modules (Charcudoc, NetRunner…) s'appliquent quand tu y es"><input type="checkbox" data-action="basculerSurPlace" {{checked surPlace}} {{#unless ../peutModifier}}disabled{{/unless}}> Sur place</label>
          </div>
          <div class="cp-bien-champs">
            <label class="cp-bien-champ"><span class="cp-lbl cp-doux">Type</span>{{#if modifiable}}<select class="cp-inp" data-bien-champ="system.type">{{selectOptions ../choixTypesPlanque selected=type}}</select>{{else}}<span>{{typeLabel}}</span>{{/if}}</label>
            <label class="cp-bien-champ"><span class="cp-lbl cp-doux">Niveau</span>{{#if modifiable}}<select class="cp-inp" data-bien-champ="system.niveau" data-type="nombre">{{selectOptions ../choixNiveauxPlanque selected=niveau}}</select>{{else}}<span class="cp-num">{{niveau}}</span>{{/if}}</label>
            <label class="cp-bien-champ"><span class="cp-lbl cp-doux">Qualité</span>{{#if modifiable}}<select class="cp-inp" data-bien-champ="system.qualite">{{selectOptions ../choixQualitesPlanque selected=qualite}}</select>{{else}}<span>{{qualiteLabel}}</span>{{/if}}</label>
            <span class="cp-bien-champ"><span class="cp-lbl cp-doux">Parking</span><span class="cp-num">{{parking}}</span></span>
          </div>
          <div class="cp-col cp-gap4">
            <span class="cp-ligne cp-entre"><span class="cp-lbl cp-doux">Modules</span><span class="cp-num cp-petit {{#if modules.pleins}}cp-rouge-txt{{/if}}">{{modules.utilises}}/{{modules.max}}</span></span>
            {{#each lignes}}
            <div class="cp-ligne cp-gap6 cp-bien-ligne" data-item-id="{{id}}">
              <button type="button" class="cp-ib cp-ib-rond" data-action="ouvrirItemBien" aria-label="Infos {{nom}}">i</button>
              <span class="cp-pousse cp-petit">{{nom}}{{#if niveau}} <span class="cp-badge-niv cp-c-{{niveau.couleur}}">{{niveau.label}}</span>{{/if}}{{#if horsSlot}} <span class="cp-doux">· d'office</span>{{/if}}{{#if infos}} <span class="cp-doux">· {{infos}}</span>{{/if}}</span>
              {{#if ../modifiable}}{{#if ../../edition}}<button type="button" class="cp-x" data-action="supprimerItemBien" aria-label="Retirer {{nom}}">×</button>{{/if}}{{/if}}
            </div>
            {{else}}<span class="cp-petit cp-doux">Aucun module{{#if modifiable}} · glisse un module sur cette carte{{/if}}</span>{{/each}}
          </div>
        </div>
        {{else}}
        <p class="cp-petit cp-doux">{{#if sansJoueur}}Ce personnage n'appartient à aucun joueur : les planques apparaissent selon les permissions des joueurs.{{else}}Pas de planque. Le MJ en donne une en accordant la propriété de l'acteur Planque au joueur.{{/if}}</p>
        {{/each}}
      </section>
    </div>
  </div>
</section>

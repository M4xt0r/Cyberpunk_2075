<div class="cp-simple">
  <div class="cp-ligne cp-gap12">
    <img class="cp-simple-img" src="{{acteur.img}}" alt="" {{#if peutModifier}}data-action="editImage" data-edit="img" title="Changer l'image"{{/if}}>
    <div class="cp-col cp-pousse">
      <span class="cp-lbl cp-jaune">{{typeLabel}}</span>
      <input class="cp-inp cp-inp-nom" type="text" name="name" value="{{acteur.name}}" {{#unless peutModifier}}disabled{{/unless}}>
    </div>
  </div>
  <label class="cp-champ">
    <span class="cp-legende">Description</span>
    <textarea class="cp-zone-texte" name="system.description" rows="8" {{#unless peutModifier}}disabled{{/unless}}>{{system.description}}</textarea>
  </label>
  <span class="cp-petit cp-doux">Fiche provisoire : la fiche complète arrive à une prochaine étape du plan.</span>
</div>
